# Copy this file to local.env.ps1 (gitignored) and fill in the real values
# from the Render dashboard -> autobott-phase1-dashboard service -> Environment tab.
# Never commit local.env.ps1 or paste these values into chat/tickets.

$env:ALPACA_ENV = "paper"
$env:ALPACA_API_KEY_ID = "PASTE_KEY_ID_HERE"
$env:ALPACA_API_SECRET_KEY = "PASTE_SECRET_HERE"
$env:ALPACA_TRADING_BASE_URL = "https://paper-api.alpaca.markets"
$env:ALPACA_DATA_BASE_URL = "https://data.alpaca.markets"
$env:AUTOBOTT_LIVE_TRADING_ENABLED = "false"
$env:AUTOBOTT_PAPER_ONLY = "true"
$env:AUTOBOTT_ALLOW_ORDER_PLACEMENT = "false"
$env:AUTOBOTT_MAX_POSITION_COST = "1000"
$env:AUTOBOTT_MAX_DAILY_LOSS = "5000"
$env:AUTOBOTT_PAPER_DISCOVERY_MAX_CONTRACT_PRICE = "8.00"
$env:AUTOBOTT_PAPER_TRADE_ALL_PASSED_SIGNALS = "false"
$env:AUTOBOTT_PAPER_MAX_NEW_ENTRY_ATTEMPTS_PER_LOOP = "25"
$env:AUTOBOTT_PAPER_MAX_OPEN_ENTRY_BUY_ORDERS = "25"
$env:AUTOBOTT_SINGLE_LEG_REAL_ENTRIES_DISABLED = "true"
$env:AUTOBOTT_CORE_RUNNER_ENABLED = "true"
$env:AUTOBOTT_MAX_TRADE_GROUP_COST = "1200"
$env:AUTOBOTT_RUNNER_MAX_COST_RATIO = "0.40"
$env:AUTOBOTT_CORE_MAX_SPREAD_PCT = "0.18"
$env:AUTOBOTT_RUNNER_MAX_SPREAD_PCT = "0.25"
$env:AUTOBOTT_CORE_MIN_OPEN_INTEREST = "100"
$env:AUTOBOTT_RUNNER_MIN_OPEN_INTEREST = "50"
$env:AUTOBOTT_CORE_MIN_VOLUME = "10"
$env:AUTOBOTT_RUNNER_MIN_VOLUME = "1"
$env:AUTOBOTT_RUNNER_EXIT_TAKE_PROFIT_PCT = "1.00"
$env:AUTOBOTT_RUNNER_EXIT_TRAILING_ACTIVATION_PCT = "0.50"
$env:AUTOBOTT_RUNNER_EXIT_TRAILING_DRAWDOWN_PCT = "0.25"
$env:AUTOBOTT_RUNNER_EXIT_STOP_LOSS_PCT = "0.70"
$env:AUTOBOTT_EXIT_TAKE_PROFIT_PCT = "0.30"
$env:AUTOBOTT_EXIT_TAKE_PROFIT_TIGHTEN_PCT = "0.50"
$env:AUTOBOTT_EXIT_TAKE_PROFIT_HARVEST_PCT = "0.80"
$env:AUTOBOTT_EXIT_TAKE_PROFIT_FORCE_EXIT_PCT = "1.20"
$env:AUTOBOTT_TAKE_PROFIT_LIMIT_PRICE_FACTOR = "0.98"
$env:AUTOBOTT_TAKE_PROFIT_REPRICE_FACTOR = "0.97"
$env:AUTOBOTT_TAKE_PROFIT_TIGHT_LIMIT_PRICE_FACTOR = "0.97"
$env:AUTOBOTT_TAKE_PROFIT_HARVEST_LIMIT_PRICE_FACTOR = "0.95"
$env:AUTOBOTT_POSITION_MONITOR_HEARTBEAT_ENABLED = "false"
$env:AUTOBOTT_POSITION_MONITOR_HEARTBEAT_SECONDS = "15"
$env:AUTOBOTT_RECENT_LOSS_GUARD_ENABLED = "false"
$env:AUTOBOTT_RECENT_LOSS_GUARD_LOOKBACK = "20"
$env:AUTOBOTT_RECENT_LOSS_GUARD_CONSECUTIVE_LOSSES = "2"
$env:AUTOBOTT_RECENT_LOSS_GUARD_MIN_SAMPLE = "3"
$env:AUTOBOTT_RECENT_LOSS_GUARD_LOSS_RATE = "0.67"
$env:AUTOBOTT_RECENT_WINNER_BIAS_ENABLED = "true"
$env:AUTOBOTT_RECENT_WINNER_BIAS_LOOKBACK = "20"
$env:AUTOBOTT_RECENT_WINNER_BIAS_MIN_SAMPLE = "2"
$env:AUTOBOTT_RECENT_WINNER_BIAS_WIN_RATE = "0.67"
$env:AUTOBOTT_RECENT_WINNER_BIAS_CONSECUTIVE_WINS = "2"
$env:AUTOBOTT_SESSION_AUTOSTART = "false"
$env:AUTOBOTT_SESSION_RUN_FOREVER = "false"
$env:AUTOBOTT_SESSION_SYMBOLS = "SPY"
$env:AUTOBOTT_SESSION_INTERVAL_SECONDS = "300"
$env:AUTOBOTT_SESSION_START_TIME = "09:35"
$env:AUTOBOTT_SESSION_END_TIME = "15:55"
$env:AUTOBOTT_SESSION_MARKET_TIMEZONE = "America/New_York"
$env:AUTOBOTT_SESSION_ARM_PAPER_EXECUTION = "false"
